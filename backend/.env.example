# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=loanguard_db

# Risk Classification Thresholds (Configurable banking risk bands)
LOW_RISK_THRESHOLD=0.30
HIGH_RISK_THRESHOLD=0.60

# Primary Model for Default Decision Support (logistic_regression, decision_tree, random_forest, xgboost)
PRIMARY_MODEL=xgboost

# Server Settings
HOST=0.0.0.0
PORT=8000
